{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life-OS",
  "version": "0.1.0",
  "identifier": "app.life-os.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Life-OS", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
